# ─── Application ───────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_DEBUG=true

# ─── Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
# Download the OAuth 2.0 client JSON and paste the fields below, OR
# point GOOGLE_CREDENTIALS_FILE to the downloaded JSON path.
GOOGLE_CREDENTIALS_FILE=credentials/google_oauth.json
GOOGLE_TOKEN_FILE=credentials/token.json

# For Service Account (server-to-server, no user consent flow):
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ─── Google Sheets ──────────────────────────────────────────────────────────
# The spreadsheet key is the long ID in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SPREADSHEET_KEY=your-spreadsheet-key-here
GOOGLE_WORKSHEET_NAME=WorkoutLog

# ─── Google Calendar ────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=primary   # or a specific calendar ID

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/fitness_ai
REDIS_URL=redis://localhost:6379/0

# ─── JWT Auth ───────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── AI (Phase 2+) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
MODEL_PATH=models/
