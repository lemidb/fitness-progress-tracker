# ─── Application ───────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
# Download the OAuth 2.0 client JSON and paste the fields below, OR
# point GOOGLE_CREDENTIALS_FILE to the downloaded JSON path.
GOOGLE_CREDENTIALS_FILE=credentials/google_oauth.json
GOOGLE_TOKEN_FILE=credentials/token.json

# For Service Account (server-to-server, no user consent flow):
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ─── Google Sheets ──────────────────────────────────────────────────────────
# The spreadsheet key is the long ID in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SPREADSHEET_KEY=your-spreadsheet-key-here
GOOGLE_WORKSHEET_NAME=WorkoutLog

# ─── Google Calendar ────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=primary   # or a specific calendar ID

# ─── Supabase (Auth + PostgreSQL) ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Use the Supabase PostgreSQL connection string (prefer the transaction pooler
# for hosted deployments). Ensure the URL scheme is postgresql+asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:password@REGION.pooler.supabase.com:6543/postgres?ssl=require&statement_cache_size=0

# ─── Redis (optional; for deferred worker phase) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI (Phase 2+) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_PATH=models/
